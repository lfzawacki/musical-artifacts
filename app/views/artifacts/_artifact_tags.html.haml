- # TODO: Hash ordering is not guaranteed, but I don't want to write extra code here
- # If this breaks it's just an aesthetic bug and then I can deal with it
- lists = {'app' => :software, 'tag' => :tags, 'format' => :file_formats }

- lists.each do |tag_name, assoc_name|

  - list = artifact.send(assoc_name).sort_by { |t| -t.taggings_count.to_i }.map(&:name)

  - if list.present? && defined?(@max_tags)
    - list.first(@max_tags[tag_name]).each do |tag|
      .label{class: "label-#{tag_name}"}
        = link_to tag, artifacts_path(tag_name.pluralize => tag)
    %br
