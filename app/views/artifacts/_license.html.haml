.license

  - short = artifact.license.short_name
  - type = artifact.license.license_type

  - if ['public', 'cc-sample', 'copyleft', 'falv13', 'wtfpl'].include? short
    = render "licenses/image_only_license", artifact: artifact, small: small, cached: true

  - elsif ['various', 'gray'].include? short
    = render "licenses/text_only_license", artifact: artifact, small: small, cached: true

  - elsif type == 'cc'
    = render "licenses/cc", artifact: artifact, small: small, cached: true

  - elsif type == 'gpl'
    = render "licenses/gpl", artifact: artifact, small: small, cached: true

  - elsif type == 'copyright'
    = render "licenses/copyright", artifact: artifact, small: small, cached: true

  - if !artifact.license.free
    .label.label-non-free
      - url = t("licenses.non_free.#{artifact.license.translation_short_name}", default: '')

      - if url.present?
        = link_to url, rel: 'nofollow', target: '_blank' do
          %i.fa.fa-lock
          = t('licenses.non_free_text')
      - else
        %i.fa.fa-lock
        = t('licenses.non_free_text')

  - if artifact.extra_license_text.present?
    .license-text
      %strong
        = t("licenses.extra_text")

      = artifact.extra_license_text_html
