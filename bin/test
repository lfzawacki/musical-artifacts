#!/usr/bin/env bash
set -e

# Usage:
#   bin/test                     run all tests (via bin/testunit)
#   bin/test -v                  verbose: show each test name
#   bin/test -n PATTERN          filter by test name (regex)
#   bin/test -f PATH             run a single test file
#   bin/test -l LINE PATH        run test at specific line

VERBOSE=false
NAME_PATTERN=""
FILE_PATH=""
LINE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v|--verbose) VERBOSE=true; shift ;;
    -n|--name) NAME_PATTERN="$2"; shift 2 ;;
    -f|--file) FILE_PATH="$2"; shift 2 ;;
    -l|--line) LINE="$2"; FILE_PATH="$3"; shift 3 ;;
    *) echo "Usage: bin/test [-v] [-n PATTERN] [-f FILE] [-l LINE FILE]"; exit 1 ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ -n "$LINE" ]; then
  exec bundle exec m "$FILE_PATH:$LINE"
elif [ -n "$FILE_PATH" ]; then
  if [ -n "$NAME_PATTERN" ]; then
    exec "$SCRIPT_DIR/testunit" "$FILE_PATH" --name="/$NAME_PATTERN/"
  else
    exec "$SCRIPT_DIR/testunit" "$FILE_PATH"
  fi
elif [ -n "$NAME_PATTERN" ]; then
  exec "$SCRIPT_DIR/testunit" --name="/$NAME_PATTERN/"
elif $VERBOSE; then
  exec "$SCRIPT_DIR/testunit" -v
else
  exec "$SCRIPT_DIR/testunit"
fi
